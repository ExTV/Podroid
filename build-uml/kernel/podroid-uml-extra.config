# Podroid additions found missing by the UML spike (configfs, and the items
# lxc-checkconfig reported), plus hostfs for host directory sharing.
CONFIG_CONFIGFS_FS=y
CONFIG_HOSTFS=y
CONFIG_NFT_COMPAT=y
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_CHECKPOINT_RESTORE=y
